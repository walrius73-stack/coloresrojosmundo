<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para ti ❤️</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            background: #000;
            overflow: hidden;
            font-family: Arial, sans-serif;
        }

        /* PANTALLA DE TRANSICIÓN (POEMA) */
        #transicion {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #1a000d, #000000);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
            padding: 20px;
            text-align: center;
            transition: opacity 1s ease;
        }

        #poema-texto {
            color: #ffb3d1;
            font-size: 19px;
            line-height: 1.6;
            max-width: 600px;
            margin-bottom: 30px;
            text-shadow: 0 2px 10px rgba(255, 0, 100, 0.4);
        }

        /* BOTÓN PARA ABRIR */
        #btn-abrir {
            background-color: #ff3366;
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 18px;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(255, 51, 102, 0.4);
            transition: transform 0.2s, background-color 0.2s;
        }

        #btn-abrir:hover {
            background-color: #ff1a4d;
            transform: scale(1.05);
        }

        /* PANTALLA PRINCIPAL (IMAGEN Y MÚSICA) */
        #inicio {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            opacity: 0;
            visibility: hidden;
            transition: opacity 1s ease;
            z-index: 5;
        }

        /* IMAGEN */
        #imagen {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        /* TEXTO DE TOQUE */
        #mensaje {
            position: absolute;
            bottom: 7%;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 20px;
            text-align: center;
            text-shadow: 0 2px 8px #000;
            opacity: 0.9;
            width: 90%;
        }
    </style>
</head>
<body>

    <!-- PANTALLA DE TRANSICIÓN CON EL POEMA -->
    <div id="transicion">
        <div id="poema-texto">
            Mi sol, mi tierra y vida, iluminas el alba y das color a la sangre que me da motor para darte mi amor, mi rubí carmesí, me pierdo en ti y en las fresas de amor que emanan de tu mirada.
        </div>
        <button id="btn-abrir" onclick="revelarSorpresa()">Abrir ❤️</button>
    </div>

    <!-- PANTALLA PRINCIPAL E IMAGEN -->
    <div id="inicio" onclick="tocarPantalla()">
        <img id="imagen" src="imagen.jpeg" alt="Para ti">
        <div id="mensaje">Toca la pantalla ❤️</div>
    </div>

    <!-- CANCIÓN DE FONDO -->
    <audio id="musica" loop>
        <source src="musica.mp3" type="audio/mpeg">
    </audio>

    <script>
        function revelarSorpresa() {
            const transicion = document.getElementById("transicion");
            const inicio = document.getElementById("inicio");
            const musica = document.getElementById("musica");

            // Reproducir la música desde el botón del poema
            musica.play().catch(error => {
                console.log("No se pudo reproducir la canción:", error);
            });

            // Desvanecer la pantalla del poema
            transicion.style.opacity = "0";
            setTimeout(() => {
                transicion.style.display = "none";
                // Mostrar la pantalla de la imagen
                inicio.style.visibility = "visible";
                inicio.style.opacity = "1";
            }, 1000);
        }

        function tocarPantalla() {
            const mensaje = document.getElementById("mensaje");
            // Ocultar el texto de "Toca la pantalla" al hacer clic
            mensaje.style.display = "none";
        }
    </script>

</body>
</html>
