<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para ti ❤️</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            background: #000;
            overflow: hidden;
        }

        /* PANTALLA PRINCIPAL */
        #inicio {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: #000;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

        /* IMAGEN */
        #imagen {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        /* TEXTO */
        #mensaje {
            position: absolute;
            bottom: 7%;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-family: Arial, sans-serif;
            font-size: 20px;
            text-align: center;
            text-shadow: 0 2px 8px #000;
            opacity: 0.9;
            width: 90%;
        }
    </style>
</head>
<body>

    <!-- PANTALLA INICIAL E IMAGEN -->
    <div id="inicio" onclick="comenzar()">
        <img id="imagen" src="imagen.jpeg" alt="Para ti">
        <div id="mensaje">Toca la pantalla ❤️</div>
    </div>

    <!-- CANCIÓN DE FONDO -->
    <audio id="musica" loop>
        <source src="musica.mp3" type="audio/mpeg">
    </audio>

    <script>
        function comenzar() {
            const musica = document.getElementById("musica");
            const mensaje = document.getElementById("mensaje");

            // Reproducir la canción
            musica.play().catch(error => {
                console.log("No se pudo reproducir la canción:", error);
            });

            // Ocultar el texto de "Toca la pantalla" al hacer clic
            mensaje.style.display = "none";
        }
    </script>

</body>
</html>
